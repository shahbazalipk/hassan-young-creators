# Copy this file to `.env` and fill in real values.
# Never commit `.env` or share secrets publicly.

# SQLite database file (local development)
DATABASE_URL="file:./dev.db"

# Strong random secrets (generate with: openssl rand -base64 48)
SESSION_SECRET="replace-with-a-long-random-session-secret-at-least-32-chars"
CSRF_SECRET="replace-with-a-different-long-random-csrf-secret"

# Parent/guardian contact — server-side only. Never exposed in frontend code.
PARENT_CONTACT_EMAIL="parent@example.com"

# First admin account created by seed (change immediately after first login)
ADMIN_EMAIL="parent@example.com"
ADMIN_PASSWORD="ChangeMe-StrongPassword-123!"
ADMIN_NAME="Hassan's Parent"

# Public site URL (used in password-reset emails)
APP_URL="http://localhost:3000"

# Optional SMTP for contact notifications + password reset
# If unset, messages still save to the admin inbox and the UI shows a friendly fallback.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Hassan Portfolio <noreply@example.com>"

# Optional Google Sign-In (OAuth Web Client ID from Google Cloud Console)
# Public client ID is safe to expose; never put a client secret in frontend code.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Upload limits
MAX_UPLOAD_BYTES="2097152"
