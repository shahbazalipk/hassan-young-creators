{
  "name": "hassan-young-creators",
  "version": "1.0.0",
  "private": true,
  "description": "Child-safe portfolio and Young Creators platform for Hassan",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:flash": "tsx scripts/seed-flash-questions.ts",
    "db:cleanup-emails": "tsx scripts/cleanup-duplicate-emails.ts",
    "db:setup": "tsx scripts/cleanup-duplicate-emails.ts && prisma db push && tsx prisma/seed.ts && tsx scripts/seed-flash-questions.ts",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "deploy:glimzo": "./scripts/deploy-glimzo.sh",
    "deploy:glimzo:push": "./scripts/deploy-glimzo.sh --push",
    "deploy:glimzo:status": "./scripts/deploy-glimzo.sh --status"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.2",
    "iron-session": "^8.0.4",
    "jose": "^6.0.12",
    "next": "^15.5.2",
    "nodemailer": "^7.0.5",
    "otpauth": "^9.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.2.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
